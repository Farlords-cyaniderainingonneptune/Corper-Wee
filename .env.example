# ============================================================================
# CORPER WEE — ENVIRONMENT VARIABLES TEMPLATE (DEVELOPMENT & PRODUCTION)
# Never commit real production secrets (.env) to source control.
# ============================================================================

# --- Runtime & Server ---
NODE_ENV=production
PORT=3000
RELEASE_VERSION=1.0.0
APP_URL=https://corperwee.ng
ADMIN_PORTAL_ORIGIN=https://admin.corperwee.ng
ALLOWED_ORIGINS=https://corperwee.ng,https://admin.corperwee.ng,capacitor://localhost,http://localhost

# --- AI Capabilities (Managed by platform secrets in preview) ---
GEMINI_API_KEY=MY_GEMINI_API_KEY

# --- Authentication & Cryptographic Secrets ---
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_SECOND_64_CHAR_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Superadmin Bootstrap Identity ---
SUPERADMIN_EMAIL=farlodunolusege@gmail.com
SUPERADMIN_STATE_CODE=OY/26C/5439

# --- PostgreSQL Production Database ---
# Example: postgresql://corperwee_app:STRONG_PASSWORD@pg-primary.internal:5432/corperwee_prod?sslmode=require
DATABASE_URL=
PG_POOL_MIN=2
PG_POOL_MAX=20
PG_SSL_MODE=require
DATA_RETENTION_DAYS=90

# --- Redis (Optional for multi-instance WebSocket Pub/Sub & distributed rate limiting) ---
# Example: rediss://:REDIS_PASSWORD@redis-prod.internal:6379/0
REDIS_URL=
REDIS_ENABLED=false
REDIS_KEY_PREFIX=corperwee:prod:

# --- Observability, Logging & Error Reporting ---
LOG_LEVEL=info
SENTRY_DSN=
ERROR_WEBHOOK_URL=
METRICS_BEARER_TOKEN=REPLACE_WITH_PROMETHEUS_SCRAPE_TOKEN

# --- Database Backups ---
BACKUP_DIR=/var/backups/corperwee
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=s3://corperwee-prod-backups/postgres

# --- Android Play Store Release Signing (CI/CD Secrets Only) ---
ANDROID_APP_ID=ng.corperwee.app
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=corperwee-release
ANDROID_KEY_PASSWORD=
